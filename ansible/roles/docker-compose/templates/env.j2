# {{ ansible_managed }}
# Environment configuration for homelab

# Domain configuration
DOMAIN={{ domain | default('localhost') }}
EMAIL={{ email | default('admin@' + (domain | default('localhost'))) }}

# User/Group IDs for file permissions
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
TZ={{ timezone | default('UTC') }}

# Database configurations
POSTGRES_USER={{ postgres_user | default('homelab') }}
POSTGRES_PASSWORD={{ postgres_password | default('changeme') }}
POSTGRES_DB={{ postgres_db | default('homelab') }}

# Redis configuration
REDIS_PASSWORD={{ redis_password | default('changeme') }}

# Monitoring
PROMETHEUS_RETENTION={{ prometheus_retention | default('30d') }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('admin') }}

# Media configurations
MEDIA_DIR={{ media_dir | default('/media') }}
DOWNLOADS_DIR={{ downloads_dir | default('/downloads') }}

# Network configuration
DOCKER_NETWORK={{ docker_network | default('homelab_network') }}